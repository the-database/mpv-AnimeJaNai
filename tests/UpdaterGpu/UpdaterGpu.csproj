<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks the updater's GPU rules (AnimeJaNaiUpdater/GpuSupport.cs) on made-up GPU lists:
       run it with dotnet run, project tests/UpdaterGpu; it exits nonzero on a failure. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../AnimeJaNaiUpdater/GpuSupport.cs" Link="GpuSupport.cs" />
  </ItemGroup>

</Project>
